rules_version = '2';

// Règles d'accès aux données (à coller dans Firestore > Règles, puis Publier).
// Chacun peut créer son compte, mais ne voit que les données du club dont il est membre.
// On devient membre en créant un club (responsable) ou avec son code d'invitation (bénévole).
// Rôles : responsable (admin), coach, bénévole (saisie des stats et publication de ses matchs, à valider).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function memberPath(c, uid) { return /databases/$(database)/documents/clubs/$(c)/members/$(uid); }
    function isMember(c) { return signedIn() && exists(memberPath(c, me())); }
    // getAfter : tient compte des écritures du même lot (création du club)
    function isAdmin(c) {
      return signedIn() && existsAfter(memberPath(c, me())) && getAfter(memberPath(c, me())).data.role == 'admin';
    }
    // Responsable ou coach : peut modifier les équipes, les matchs archivés et le nom du club.
    function isEditor(c) {
      return isMember(c) && get(memberPath(c, me())).data.role in ['admin', 'coach'];
    }
    function inviteOk(code, c) {
      return code is string
        && exists(/databases/$(database)/documents/invites/$(code))
        && get(/databases/$(database)/documents/invites/$(code)).data.clubId == c;
    }

    // Club de l'utilisateur (simple repère : l'accès est contrôlé par members)
    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    // Codes d'invitation : lisibles un par un si on connaît le code, jamais en liste.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isAdmin(request.resource.data.clubId);
      allow delete: if isAdmin(resource.data.clubId);
      allow update: if false;
    }

    match /clubs/{c} {
      allow read: if isMember(c);
      allow create: if signedIn() && request.resource.data.owner == me();
      // Le créateur (owner) ne change jamais. Les coachs peuvent seulement renommer le club ; les bénévoles rien.
      allow update: if request.resource.data.owner == resource.data.owner && (
        isAdmin(c) || (isEditor(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])));
      // Le responsable peut supprimer le club (après ses équipes, matchs et membres).
      allow delete: if isAdmin(c);

      match /members/{uid} {
        allow read: if isMember(c) || (signedIn() && me() == uid);
        allow create: if signedIn() && me() == uid && (
          // Créateur du club : responsable
          (request.resource.data.role == 'admin'
            && getAfter(/databases/$(database)/documents/clubs/$(c)).data.owner == me())
          // Avec le code d'invitation en cours : bénévole
          || (request.resource.data.role == 'benevole' && inviteOk(request.resource.data.code, c)));
        // Seul un responsable change les rôles (admin, coach, benevole) ; chacun peut changer son pseudo ; on peut toujours quitter le club.
        allow update: if (isAdmin(c) && request.resource.data.role in ['admin', 'coach', 'benevole'])
          || (signedIn() && me() == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
        allow delete: if isAdmin(c) || (signedIn() && me() == uid);
      }

      match /teams/{id} {
        allow read: if isMember(c);
        allow write: if isEditor(c);
      }
      // Matchs publiés. Un bénévole publie ses matchs « en attente de validation » (st == 'pending') ;
      // un coach ou un responsable les valide (st == 'ok'). Un match validé n'est supprimé que par
      // un coach ou un responsable ; un match en attente aussi par celui qui l'a publié.
      match /matches/{id} {
        allow read: if isMember(c);
        allow create: if isEditor(c)
          || (isMember(c) && request.resource.data.st == 'pending' && request.resource.data.author == me());
        // L'auteur d'un match en attente peut encore le corriger (il reste en attente, à son nom).
        allow update: if isEditor(c)
          || (isMember(c) && resource.data.st == 'pending' && resource.data.author == me()
            && request.resource.data.st == 'pending' && request.resource.data.author == me());
        allow delete: if isEditor(c)
          || (isMember(c) && resource.data.st == 'pending' && resource.data.author == me());
      }
    }
  }
}
