rules_version = '2';

// Règles d'accès aux données (à coller dans Firestore > Règles, puis Publier).
// Chacun peut créer son compte, mais ne voit que les données du club dont il est membre.
// On devient membre en créant un club (responsable) ou avec son code d'invitation (coach).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function memberPath(c, uid) { return /databases/$(database)/documents/clubs/$(c)/members/$(uid); }
    function isMember(c) { return signedIn() && exists(memberPath(c, me())); }
    // getAfter : tient compte des écritures du même lot (création du club)
    function isAdmin(c) {
      return signedIn() && existsAfter(memberPath(c, me())) && getAfter(memberPath(c, me())).data.role == 'admin';
    }
    function inviteOk(code, c) {
      return code is string
        && exists(/databases/$(database)/documents/invites/$(code))
        && get(/databases/$(database)/documents/invites/$(code)).data.clubId == c;
    }

    // Club de l'utilisateur (simple repère : l'accès est contrôlé par members)
    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    // Codes d'invitation : lisibles un par un si on connaît le code, jamais en liste.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isAdmin(request.resource.data.clubId);
      allow delete: if isAdmin(resource.data.clubId);
      allow update: if false;
    }

    match /clubs/{c} {
      allow read: if isMember(c);
      allow create: if signedIn() && request.resource.data.owner == me();
      // Le créateur (owner) ne change jamais. Les coachs peuvent seulement renommer le club.
      allow update: if request.resource.data.owner == resource.data.owner && (
        isAdmin(c) || (isMember(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])));
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(c) || (signedIn() && me() == uid);
        allow create: if signedIn() && me() == uid && (
          // Créateur du club : responsable
          (request.resource.data.role == 'admin'
            && getAfter(/databases/$(database)/documents/clubs/$(c)).data.owner == me())
          // Avec le code d'invitation en cours : coach
          || (request.resource.data.role == 'coach' && inviteOk(request.resource.data.code, c)));
        // Seul un responsable change les rôles ; on peut toujours quitter le club.
        allow update: if isAdmin(c);
        allow delete: if isAdmin(c) || (signedIn() && me() == uid);
      }

      match /teams/{id} { allow read, write: if isMember(c); }
      match /matches/{id} { allow read, write: if isMember(c); }
    }
  }
}
